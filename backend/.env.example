# Copy to .env and adjust. Nothing here is secret by default — that is the
# point: the original project hard-coded these values inside a source file.
PORT=5000
NODE_ENV=development

# Persistence. Use 'memory' for local runs and tests (no database required),
# 'mysql' for a real deployment.
STORAGE=mysql

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=spk_wood
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# Comma-separated origins allowed to call the API. Never ship '*' in production.
CORS_ORIGINS=http://localhost:3000
